# Offline by default. Nothing here is a secret.
KITLINE_MODE=offline
KITLINE_EMBEDDINGS=local
KITLINE_VECTOR_STORE=local
KITLINE_SESSION_STORE=memory
KITLINE_MAX_ATTEMPTS=2

# File-backed sessions, used by docker compose.
# KITLINE_SESSION_STORE=file
# KITLINE_SESSION_DIR=.data/sessions

# Bedrock. Requires credentials and model access. The validator still runs locally.
# KITLINE_MODE=bedrock
# KITLINE_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# KITLINE_BEDROCK_REGION=us-west-2
# KITLINE_EMBEDDINGS=bedrock
# AWS_REGION=us-west-2

# Optional stores. Install the package extra: pip install -e "./backend[stores]"
# KITLINE_VECTOR_STORE=pgvector
# KITLINE_DATABASE_URL=postgresql://kitline:kitline@localhost:5432/kitline
# KITLINE_VECTOR_STORE=opensearch
# KITLINE_OPENSEARCH_ENDPOINT=https://xxxxxxxx.us-west-2.aoss.amazonaws.com
# KITLINE_SESSION_STORE=dynamodb
# KITLINE_SESSION_TABLE=kitline-sessions
